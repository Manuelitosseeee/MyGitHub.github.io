<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
 <TextView android:id="@+id/nickname" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MyGuitarHub" android:textSize="17sp" android:textStyle="bold" android:textColor="#ffffff"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Configura il tuo amico" android:textSize="12sp" android:textColor="#cccccc"/>
 <ImageView android:id="@+id/room" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Stanza Pixel Story originale"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#aaaaaa"/>
  <TextView android:id="@+id/refresh" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="↻" android:textSize="25sp" android:textColor="#ffffff" android:contentDescription="Aggiorna stato"/>
 </LinearLayout>
</LinearLayout>
