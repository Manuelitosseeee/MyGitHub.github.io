    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "VAPID_PUBLIC": "BA6KzEbRFXoDsBN62ZWQBoDWJ7MDstcn9skD6n2OHCpcNcnBkaw2sgi54xAOWMDaNn6z-_TkrEnmbOxGx-PCP8A"
  }
}
